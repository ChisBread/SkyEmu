FROM --platform=linux/amd64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# 添加 arm64 架构支持并配置 ports 源
RUN dpkg --add-architecture arm64 && \
    sed -i 's/http:\/\/archive.ubuntu.com\/ubuntu\//[arch=amd64] http:\/\/archive.ubuntu.com\/ubuntu\//g' /etc/apt/sources.list && \
    echo "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports jammy-security main restricted universe multiverse" >> /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y \
    build-essential \
    cmake \
    make \
    git \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu \
    pkg-config \
    crossbuild-essential-arm64 \
    libasound2-dev:arm64 \
    libx11-dev:arm64 \
    libxi-dev:arm64 \
    libxrandr-dev:arm64 \
    libxinerama-dev:arm64 \
    libxcursor-dev:arm64 \
    libgl1-mesa-dev:arm64 \
    libegl1-mesa-dev:arm64 \
    libglu1-mesa-dev:arm64 \
    libglx-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

# 设置 pkg-config 查找 arm64 库
ENV PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig
ENV PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig

WORKDIR /build

# 复制项目文件
COPY . .

# 创建 CMake 工具链文件
RUN echo 'set(CMAKE_SYSTEM_NAME Linux)' > /build/aarch64-toolchain.cmake && \
    echo 'set(CMAKE_SYSTEM_PROCESSOR aarch64)' >> /build/aarch64-toolchain.cmake && \
    echo 'set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)' >> /build/aarch64-toolchain.cmake && \
    echo 'set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)' >> /build/aarch64-toolchain.cmake && \
    echo 'set(CMAKE_FIND_ROOT_PATH "/usr/aarch64-linux-gnu;/usr/lib/aarch64-linux-gnu")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)' >> /build/aarch64-toolchain.cmake && \
    echo 'set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)' >> /build/aarch64-toolchain.cmake && \
    echo 'set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)' >> /build/aarch64-toolchain.cmake && \
    echo 'set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)' >> /build/aarch64-toolchain.cmake && \
    echo 'set(ALSA_INCLUDE_DIR "/usr/include/aarch64-linux-gnu")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(ALSA_LIBRARY "/usr/lib/aarch64-linux-gnu/libasound.so")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(OPENGL_INCLUDE_DIR "/usr/include")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(OPENGL_opengl_LIBRARY "/usr/lib/aarch64-linux-gnu/libOpenGL.so")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(OPENGL_glx_LIBRARY "/usr/lib/aarch64-linux-gnu/libGLX.so")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(X11_X11_INCLUDE_PATH "/usr/include")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(X11_X11_LIB "/usr/lib/aarch64-linux-gnu/libX11.so")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(X11_Xrandr_INCLUDE_PATH "/usr/include")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(X11_Xrandr_LIB "/usr/lib/aarch64-linux-gnu/libXrandr.so")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(X11_Xi_INCLUDE_PATH "/usr/include")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(X11_Xi_LIB "/usr/lib/aarch64-linux-gnu/libXi.so")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(X11_Xinerama_INCLUDE_PATH "/usr/include")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(X11_Xinerama_LIB "/usr/lib/aarch64-linux-gnu/libXinerama.so")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(X11_Xcursor_INCLUDE_PATH "/usr/include")' >> /build/aarch64-toolchain.cmake && \
    echo 'set(X11_Xcursor_LIB "/usr/lib/aarch64-linux-gnu/libXcursor.so")' >> /build/aarch64-toolchain.cmake

# 编译
RUN mkdir -p build && cd build && \
    cmake -DCMAKE_TOOLCHAIN_FILE=/build/aarch64-toolchain.cmake \
          -DCMAKE_BUILD_TYPE=Release \
          -DUSE_SYSTEM_CURL=OFF \
          -DUSE_SYSTEM_OPENSSL=OFF \
          -DUSE_SYSTEM_SDL2=OFF \
          .. && \
    cmake --build . --target skyemu_libretro --config Release -j$(nproc)

CMD ["cp", "-r", "/build/build/", "/output/"]
