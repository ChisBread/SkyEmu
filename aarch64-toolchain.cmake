set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
set(CMAKE_FIND_ROOT_PATH "/usr/aarch64-linux-gnu;/usr/lib/aarch64-linux-gnu")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ALSA_INCLUDE_DIR "/usr/include/aarch64-linux-gnu")
set(ALSA_LIBRARY "/usr/lib/aarch64-linux-gnu/libasound.so")
set(OPENGL_INCLUDE_DIR "/usr/include")
set(OPENGL_opengl_LIBRARY "/usr/lib/aarch64-linux-gnu/libOpenGL.so")
set(OPENGL_glx_LIBRARY "/usr/lib/aarch64-linux-gnu/libGLX.so")
set(X11_X11_INCLUDE_PATH "/usr/include")
set(X11_X11_LIB "/usr/lib/aarch64-linux-gnu/libX11.so")
set(X11_Xrandr_INCLUDE_PATH "/usr/include")
set(X11_Xrandr_LIB "/usr/lib/aarch64-linux-gnu/libXrandr.so")
set(X11_Xi_INCLUDE_PATH "/usr/include")
set(X11_Xi_LIB "/usr/lib/aarch64-linux-gnu/libXi.so")
set(X11_Xinerama_INCLUDE_PATH "/usr/include")
set(X11_Xinerama_LIB "/usr/lib/aarch64-linux-gnu/libXinerama.so")
set(X11_Xcursor_INCLUDE_PATH "/usr/include")
set(X11_Xcursor_LIB "/usr/lib/aarch64-linux-gnu/libXcursor.so")
